---
import type { CollectionEntry } from "astro:content";
import { netlifyImage } from "@/utils/netlifyImage";
import ObraViewport from "./ObraViewport";

type Obra = CollectionEntry<"obras">;

type MediaBlock =
  | { _block: "imagen"; src: string; alt?: string | undefined }
  | { _block: "video"; src: string; alt?: string | undefined }
  | { _block: "iframe"; url: string }
  | {
      _block: "modelo_3d";
      main_model: string;
      lods?: Array<{ nivel: string; file: string }> | undefined;
    };

interface Props {
  mediaContent?: MediaBlock[] | undefined;
  slug: string;
}

const { mediaContent, slug } = Astro.props;

// Helper function to assemble LOD array for 3D models
// Order: Alto → Medio → Bajo → main_model (main_model as lowest quality fallback)
function assembleLodArray(
  main_model: string,
  lods?: Array<{ nivel: string; file: string }>
): string[] {
  if (!lods || lods.length === 0) {
    return [main_model];
  }

  const nivelOrder = { Alto: 0, Medio: 1, Bajo: 2 };
  const sorted = [...lods].sort(
    (a, b) => (nivelOrder[a.nivel as keyof typeof nivelOrder] ?? 99) - (nivelOrder[b.nivel as keyof typeof nivelOrder] ?? 99)
  );

  return [...sorted.map((l) => l.file), main_model];
}

const mediaItems = mediaContent ?? [];

const hasMultiple = mediaItems.length > 1;
const controlButtonClass =
  "z-20 p-1.5 rounded-md bg-black/40 hover:bg-black/70 text-white/70 hover:text-white transition-all duration-200 backdrop-blur-sm opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus:opacity-100 [@media(hover:none)]:opacity-100";
---

<div
  id="media-viewer"
  class="group relative w-full flex items-center justify-center px-1 overflow-hidden
    h-[60dvh] lg:flex-1 lg:h-full
    data-fullscreen:fixed data-fullscreen:inset-0 data-fullscreen:z-100
    data-fullscreen:w-screen data-fullscreen:h-dvh
    data-fullscreen:bg-bg data-fullscreen:px-0"
>
  <!-- Fullscreen toggle button (top-right) -->
  <button
    id="fullscreen-btn"
    aria-label="Ver en pantalla completa"
    class={`absolute top-3 right-3 ${controlButtonClass}`}
  >
    <svg id="icon-expand" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
    </svg>
    <svg id="icon-compress" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" />
    </svg>
  </button>

  {mediaItems.length === 0 && (
    <div class="text-muted text-sm">No media content</div>
  )}

  {mediaItems.length > 0 && (
    <div class="relative h-full w-full">
      {hasMultiple && (
        <>
          <button
            id="btn-prev"
            aria-label="Ver anterior"
            class={`absolute left-3 top-1/2 -translate-y-1/2 ${controlButtonClass} hidden`}
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            id="btn-next"
            aria-label="Ver siguiente"
            class={`absolute right-3 top-1/2 -translate-y-1/2 ${controlButtonClass}`}
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </>
      )}

      <div class="relative h-full w-full">
        {mediaItems.map((item, index) => (
          <div
            data-slide={index}
            class:list={[
              "absolute inset-0 flex items-center justify-center transition-opacity duration-300",
              index === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none",
            ]}
          >
            {item._block === "imagen" && (
              <img
                transition:name={index === 0 ? `img-${slug}` : undefined}
                src={netlifyImage(item.src, 1600, undefined, { fit: "contain", preserveAspectRatio: true })}
                srcset={`${netlifyImage(item.src, 800, undefined, { fit: "contain", preserveAspectRatio: true })} 800w, ${netlifyImage(item.src, 1200, undefined, { fit: "contain", preserveAspectRatio: true })} 1200w, ${netlifyImage(item.src, 1600, undefined, { fit: "contain", preserveAspectRatio: true })} 1600w`}
                sizes="(min-width: 1024px) 75vw, 100vw"
                width="1600"
                alt={item.alt || ""}
                class="max-h-[60dvh] lg:max-h-full w-auto object-contain
                  group-data-fullscreen:w-full group-data-fullscreen:h-full
                  group-data-fullscreen:max-h-dvh group-data-fullscreen:lg:max-h-dvh"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
                decoding="async"
              />
            )}

            {item._block === "video" && (
              <video
                src={item.src}
                autoplay
                muted
                loop
                playsinline
                class="max-h-[60dvh] lg:max-h-full w-auto object-contain
                  group-data-fullscreen:max-h-dvh group-data-fullscreen:lg:max-h-dvh"
              />
            )}

            {item._block === "iframe" && (
              <iframe
                src={item.url}
                class="w-full aspect-video"
                allow="autoplay; fullscreen"
                title={`Embedded media for ${slug}`}
              />
            )}

            {item._block === "modelo_3d" && (
              <div class="absolute inset-0">
                <ObraViewport
                  client:only="react"
                  modelFiles={assembleLodArray(item.main_model, item.lods)}
                  autoRotate={true}
                  environment="custom"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  function setupMediaViewer() {
    const viewer = document.getElementById("media-viewer");
    if (!viewer) return;

    const btn = document.getElementById("fullscreen-btn");
    const iconExpand = document.getElementById("icon-expand");
    const iconCompress = document.getElementById("icon-compress");
    const prevBtn = document.getElementById("btn-prev");
    const nextBtn = document.getElementById("btn-next");
    const slides = Array.from(viewer.querySelectorAll<HTMLElement>("[data-slide]"));
    let currentIndex = 0;

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;

      if (slides.length <= 1) {
        prevBtn.classList.add("hidden");
        nextBtn.classList.add("hidden");
        return;
      }

      prevBtn.classList.toggle("hidden", currentIndex === 0);
      nextBtn.classList.toggle("hidden", currentIndex >= slides.length - 1);
    }

    function setActiveSlide(index: number) {
      if (slides.length === 0) return;

      const safeIndex = Math.max(0, Math.min(index, slides.length - 1));
      currentIndex = safeIndex;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === currentIndex;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("pointer-events-auto", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
      });

      updateArrows();
    }

    function enterFullscreen() {
      if (!viewer) return;
      viewer.setAttribute("data-fullscreen", "");
      iconExpand?.classList.add("hidden");
      iconCompress?.classList.remove("hidden");
      btn?.setAttribute("aria-label", "Salir de pantalla completa");
      document.body.style.overflow = "hidden";
    }

    function exitFullscreen() {
      if (!viewer) return;
      viewer.removeAttribute("data-fullscreen");
      iconExpand?.classList.remove("hidden");
      iconCompress?.classList.add("hidden");
      btn?.setAttribute("aria-label", "Ver en pantalla completa");
      document.body.style.overflow = "";
      requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
    }

    btn?.addEventListener("click", () => {
      if (!viewer) return;
      viewer.hasAttribute("data-fullscreen") ? exitFullscreen() : enterFullscreen();
    });

    prevBtn?.addEventListener("click", () => {
      setActiveSlide(currentIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      setActiveSlide(currentIndex + 1);
    });

    function handleKeydown(e: KeyboardEvent) {
      if (!viewer) return;

      if (e.key === "Escape" && viewer.hasAttribute("data-fullscreen")) {
        exitFullscreen();
        return;
      }

      if (slides.length <= 1) return;

      if (e.key === "ArrowRight") {
        setActiveSlide(currentIndex + 1);
      } else if (e.key === "ArrowLeft") {
        setActiveSlide(currentIndex - 1);
      }
    }

    document.addEventListener("keydown", handleKeydown);

    setActiveSlide(0);

    const cleanup = () => {
      exitFullscreen();
      document.removeEventListener("keydown", handleKeydown);
    };

    document.addEventListener("astro:before-preparation", cleanup, { once: true });
  }

  document.addEventListener("astro:page-load", setupMediaViewer);
</script>
