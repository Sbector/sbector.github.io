---
interface Props {
  back?: boolean;
}

const { back } = Astro.props;

const links = [
  { href: "/about", label: "Acerca de" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="fixed w-full top-0 z-50 h-10 bg-bg/80 backdrop-blur border-b border-border">
  <nav class="max-w-6xl mx-auto px-6 pt-2 flex justify-between items-center text-sm tracking-wide">

    <!-- Left Section: Back + Logo -->
    <div class="flex items-center gap-4">
      {back && (
        <button
          onclick="if (history.length > 1) { history.back(); } else { window.location.href = '/'; }"
          class="hover:opacity-60 transition"
          aria-label="Volver"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"
            />
          </svg>
        </button>
      )}
      <a href="/" class="hover:opacity-60 transition">
        sbector
      </a>
    </div>

    <!-- Links -->
    <div class="flex gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="hover:opacity-60 transition"
        >
          {link.label}
        </a>
      ))}
    </div>

  </nav>
</header>