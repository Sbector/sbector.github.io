---
import Layout from "@/layouts/Layout.astro";
import MediaViewer from "@/components/MediaViewer.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

type Obra = CollectionEntry<"obras">;

export async function getStaticPaths() {
  const obras = await getCollection("obras");

  return obras
    .filter((obra) => obra.data.status === "published")
    .map((obra) => ({
      params: { slug: obra.data.slug },
      props: { obra },
    }));
}

const { obra } = Astro.props as { obra: Obra };
const { Content } = await render(obra);
---

<Layout title={`${obra.data.title} | sbector`} back={true}>
  <!-- PRIMERA VISTA -->
  <section
    class="flex flex-col lg:flex-row lg:h-[calc(100dvh-var(--spacing-nav))]"
  >
    <!-- Media Viewer -->
    <MediaViewer
      mediaContent={obra.data.media_content}
      slug={obra.data.slug}
    />

    <!-- Ficha -->
    <div class="w-full lg:w-[420px] flex lg:items-end">
      <div class="px-6 lg:px-10 py-8 lg:pb-16">
        <h1 class="text-xl md:text-2xl lowercase tracking-wide">
          {obra.data.title}
        </h1>

        <p class="mt-2 text-sm text-muted">
          {obra.data.year}
        </p>

        {
          obra.data.description && (
            <p class="mt-4 text-sm text-text leading-relaxed max-w-sm">
              {obra.data.description}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <!-- CONTENIDO -->
  {
    obra.body && (
      <section id="content-section" class="max-w-2xl mx-auto px-6 md:px-10 py-24">
        <div class="editorial">
          <Content />
        </div>
      </section>
    )
  }

  <!-- Scroll indicator (only if there's body content) -->
  {obra.body && (
    <button
      id="scroll-indicator"
      aria-label="Ver más contenido"
      class="fixed bottom-6 right-6 z-40 p-2 text-muted hover:text-text transition-colors duration-200"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </button>

    <script>
      function setupScrollIndicator() {
        const btn = document.getElementById('scroll-indicator');
        const section = document.getElementById('content-section');
        if (!btn || !section) return;

        function updateVisibility() {
          if (window.scrollY > 100) {
            btn.style.opacity = '0';
            btn.style.pointerEvents = 'none';
          } else {
            btn.style.opacity = '1';
            btn.style.pointerEvents = '';
          }
        }

        btn.addEventListener('click', () => {
          section.scrollIntoView({ behavior: 'smooth' });
        });

        window.addEventListener('scroll', updateVisibility, { passive: true });
        updateVisibility();

        document.addEventListener('astro:before-preparation', () => {
          window.removeEventListener('scroll', updateVisibility);
        }, { once: true });
      }

      document.addEventListener('astro:page-load', setupScrollIndicator);
    </script>
  )}
</Layout>
